package app;
//Доходи оподатковуются за прогресивною шкалою оподаткування:
//
//від 0 до 10000, включно, за ставкою 2,5%.
//від 10000, виключно, до 25000, включно, за ставкою 4,3%.
//більше 25000, за ставкою 6,7%.
//Необхідно розрахувати суму податку від певної суми доходу. Сума податку дорівнює відсотку від суми доходу

import java.util.Scanner;

public class Main  {
   static double RATE1 = 2.5;
   static double RATE2 = 4.3;
   static double RATE3 = 6.5;
   static double income;
   static double income2 = 10000.00;
   static double income3 = 25000.00;
   static double sum;
   static String output;

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Введіть суму доходу: ");
        income = sc.nextInt();

            if (income <= income2) {
                sum = (income*RATE1)/100;
            }
            else {
            if (income2 <= income & income <= income3){
                sum = (income*RATE2)/100;
            }
             else {
            sum = (income*RATE3)/100;
        }
            }
            output = "Сума податку дорівнює " + sum;
            System.out.println(output);
         }
}
